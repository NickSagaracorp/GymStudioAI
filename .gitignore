# dependencias
node_modules/

# Expo y Metro
.expo/
.expo-export/
dist/
web-build/
expo-env.d.ts
expo-env.d.ts.map
.metro-health-check*

# proyectos nativos: los regenera `npx expo prebuild`
/ios
/android
.kotlin/

# artefactos de compilación: se generan, no se versionan
*.apk
*.aab
*.ipa
*.app
*.dSYM.zip

# claves, certificados y variables de entorno
# .env lleva la clave de OpenAI: nunca debe subirse
.env
.env.*
!.env.example
*.jks
*.keystore
*.p8
*.p12
*.key
*.pem
*.mobileprovision
*.cer
*.certSigningRequest
google-services.json
GoogleService-Info.plist

# catálogo de ejercicios: lo descarga y genera `npm run catalogo`
assets/catalog/ejercicios.json
assets/thumbs/

# TypeScript y pruebas
*.tsbuildinfo
coverage/

# registros
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# sistema operativo
.DS_Store
Thumbs.db
