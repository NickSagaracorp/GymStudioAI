{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "PON_AQUI_TU_APPLE_ID",
        "ascAppId": "PON_AQUI_EL_ID_DE_APP_STORE_CONNECT",
        "appleTeamId": "PON_AQUI_TU_TEAM_ID"
      }
    }
  }
}
