{
  "expo": {
    "name": "GymStudio AI",
    "slug": "gymstudioai",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sagaracorp.gymstudioai",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sagaracorp.gymstudioai",
      "versionCode": 3,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "GymStudio AI usa tus fotos para estimar las calorías de tus comidas.",
          "cameraPermission": "GymStudio AI usa la cámara para fotografiar tus comidas y estimar sus calorías."
        }
      ]
    ],
    "scheme": "gymstudioai",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "85ed5889-1cc2-4966-a5df-872596d4da33"
      }
    },
    "owner": "sagaracorp"
  }
}
